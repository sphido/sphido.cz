{
	"private": true,
	"author": "Roman O\u017eana <roman@ozana.cz> (https://ozana.cz)",
	"license": "MIT",
	"repository": "sphido/sphido.cz",
	"type": "module",
	"packageManager": "pnpm@11.21.0",
	"scripts": {
		"build": "pnpm run build:html && pnpm run build:css",
		"build:html": "node index.js",
		"build:css": "tailwindcss -i ./src/sphido.css -o ./public/sphido.css",
		"css": "tailwindcss -i ./src/sphido.css -o ./public/sphido.css --watch",
		"dev": "node dev.js",
		"format": "biome format --write",
		"deploy": "gh-pages -d public"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@sindresorhus/slugify": "^3.0.0",
		"@sphido/core": "^3.1.0",
		"@sphido/dev": "^1.0.0",
		"@sphido/markdown": "^2.0.0",
		"@sphido/sitemap": "^4.0.0",
		"@tailwindcss/cli": "^4.2.2",
		"@tailwindcss/typography": "^0.5.19",
		"gh-pages": "^6.3.0",
		"globby": "^16.2.0",
		"got": "^15.0.0",
		"shiki": "^4.4.3",
		"tailwindcss": "^4.2.2"
	}
}
